; SPDX-License-Identifier: MIT
let((h r)
 h=alHeap(20)
 foreach(n '(9 2 8 1 7 3) alPush(h list(n n)))
 foreach(n '(1 2 3 7 8 9)
  r=alPop(h) unless(car(r)==n error("Heap order mismatch")))
 unless(alPop(h)==nil error("Empty heap result"))
 unless(alOverlap(alBox(0 0 1 1) alBox(1.1 0 2 1) 0.2) error("Spacing check failed"))
 when(alOverlap(alBox(0 0 1 1) alBox(1.2 0 2 1) 0.2) error("Exact spacing rejected"))
 printf("AL_NATIVE_TESTS_OK\n"))

let((a b values first second heap)
 a=alRng(0) b=alRng(0)
 unless(alRand(a 2147483647)==48271 error("PRNG reference vector mismatch"))
 unless(alRand(a 2147483647)==182605794 error("PRNG second vector mismatch"))
 a=alRng(17) b=alRng(17)
 first=alShuffle('(0 1 2 3 4 5 6 7) a)
 second=alShuffle('(0 1 2 3 4 5 6 7) b)
 unless(equal(first second) error("Seeded shuffling is not reproducible"))
 unless(equal(sort(first 'lessp) '(0 1 2 3 4 5 6 7)) error("Shuffle lost an element"))
 heap=alHeap(8)
 alPush(heap '(2 99 2 0))
 alPush(heap '(1 5 1 9))
 alPush(heap '(1 4 1 3))
 unless(cadr(alPop(heap))==4 && cadr(alPop(heap))==5 && cadr(alPop(heap))==99
  error("Heap tie-breaking changed path-cost priority"))
 printf("AL_SEED_TESTS_OK\n"))
